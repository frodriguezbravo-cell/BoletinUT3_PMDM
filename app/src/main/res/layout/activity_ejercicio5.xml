<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EJERCICIO 5"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FF007F"
        android:textAlignment="center"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calculadora (TableLayout)"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:textAlignment="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#1E1E1E"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center_vertical|end"
        android:padding="12dp"
        android:layout_marginBottom="12dp" />

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:stretchColumns="*">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btnLimpiar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:text="C"
                android:textColor="#FF007F"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="#1E1E1E"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btnParentesis"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:text="( )"
                android:textColor="#FF007F"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="#1E1E1E"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btnPorcentaje"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:text="%"
                android:textColor="#FF007F"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="#1E1E1E"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btnDividir"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:text="÷"
                android:textColor="#FF007F"
                android:textSize="20sp"
                android:textStyle="bold"
                android:backgroundTint="#1E1E1E"
                app:cornerRadius="6dp" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:text="7"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:backgroundTint="#2A2A2A"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btn8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:text="8"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:backgroundTint="#2A2A2A"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btn9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:text="9"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:backgroundTint="#2A2A2A"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btnMultiplicar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:text="×"
                android:textColor="#FF007F"
                android:textSize="20sp"
                android:textStyle="bold"
                android:backgroundTint="#1E1E1E"
                app:cornerRadius="6dp" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:text="4"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:backgroundTint="#2A2A2A"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btn5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:text="5"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:backgroundTint="#2A2A2A"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btn6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:text="6"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:backgroundTint="#2A2A2A"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btnResta"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:text="-"
                android:textColor="#FF007F"
                android:textSize="20sp"
                android:textStyle="bold"
                android:backgroundTint="#1E1E1E"
                app:cornerRadius="6dp" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:backgroundTint="#2A2A2A"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btn2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:text="2"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:backgroundTint="#2A2A2A"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btn3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:text="3"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:backgroundTint="#2A2A2A"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btnSuma"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:text="+"
                android:textColor="#FF007F"
                android:textSize="20sp"
                android:textStyle="bold"
                android:backgroundTint="#1E1E1E"
                app:cornerRadius="6dp" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btnSigno"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:text="+/-"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:backgroundTint="#2A2A2A"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btn0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:backgroundTint="#2A2A2A"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btnPunto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:text="."
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:backgroundTint="#2A2A2A"
                app:cornerRadius="6dp" />

            <Button
                android:id="@+id/btnIgual"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:text="="
                android:textColor="#000000"
                android:textSize="22sp"
                android:textStyle="bold"
                android:backgroundTint="#FF007F"
                app:cornerRadius="6dp" />
        </TableRow>

    </TableLayout>

    <Button
        android:id="@+id/btnVolverEx5"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:text="Volver al Menú"
        android:textColor="#000000"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#FF007F"
        app:cornerRadius="8dp" />

</LinearLayout>