<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicios Evaluables UT3"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textAlignment="center"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnEjercicio1"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Ejercicio 1: Validar URL"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#FF007F"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnEjercicio2"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Ejercicio 2: Navegación retrasada (10s)"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#FF007F"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnEjercicio3"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Ejercicio 3: Banderas (LinearLayout)"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#FF007F"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnEjercicio4"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Ejercicio 4: Matriz (FrameLayout)"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#FF007F"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnEjercicio5"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Ejercicio 5: Calculadora (TableLayout)"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#FF007F"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnEjercicio6"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Ejercicio 6: Perfil (ConstraintLayout)"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#FF007F"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>