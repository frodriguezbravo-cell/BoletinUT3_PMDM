<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/app-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EJERCICIO 3"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FF007F"
            android:textAlignment="center"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Layouts Anidados con LinearLayout"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textAlignment="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona un botón para abrir la estructura de banderas generada mediante LinearLayouts anidados."
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:textAlignment="center"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnBandera1"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Ver Bandera 1 (Franjas Verticales)"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#FF007F"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnBandera2"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Ver Bandera 2 (Franjas Divididas)"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#FF007F"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnBandera3"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Ver Bandera 3 (Estructura Mixta)"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#FF007F"
            app:cornerRadius="12dp"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnVolverPrincipal"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Volver al Menú Principal"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#FF007F"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>